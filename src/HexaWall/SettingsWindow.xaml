<Window x:Class="HexaWall.SettingsWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HEXAWALL · Configuración" Width="680" Height="780"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Foreground="#F1F3F7" FontFamily="Segoe UI"
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#2CE8C6"/>
        <SolidColorBrush x:Key="Panel" Color="#181A20"/>
        <SolidColorBrush x:Key="Field" Color="#20242D"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F1F3F7"/></Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F1F3F7"/><Setter Property="Background" Value="#252A34"/>
            <Setter Property="Padding" Value="17,11"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="9" BorderBrush="#39414E" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Face" Property="Background" Value="#303744"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.7"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#F1F3F7"/><Setter Property="Background" Value="{StaticResource Field}"/>
            <Setter Property="BorderBrush" Value="#39414E"/><Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="SelectionBrush" Value="#246F65"/><Setter Property="Padding" Value="12,11"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9">
                        <ScrollViewer x:Name="PART_ContentHost"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Background="#39414E" Height="4" CornerRadius="2" Margin="8,0"/>
                        <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="#2CE8C6" Height="4" CornerRadius="2" Margin="8,0,0,0"/></ControlTemplate></RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="20" Height="20" Cursor="Hand">
                                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#2CE8C6" Stroke="#181A20" StrokeThickness="3"/></ControlTemplate></Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/><Setter Property="Background" Value="#181A20"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"
                           Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                        <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#465160" CornerRadius="4" Margin="1,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F1F3F7"/><Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Face" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Face" Property="Background" Value="#303744"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F1F3F7"/><Setter Property="Background" Value="{StaticResource Field}"/>
            <Setter Property="MinHeight" Value="44"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                                <Border Background="#20242D" BorderBrush="#39414E" BorderThickness="1" CornerRadius="9">
                                    <Path Data="M 0 0 L 5 5 L 10 0" Stroke="#2CE8C6" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                </Border>
                            </ControlTemplate></ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="13,0,40,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="#20242D" BorderBrush="#2CE8C6" BorderThickness="1" CornerRadius="8" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,4,0,0" Padding="3">
                                <ScrollViewer MaxHeight="240"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F1F3F7"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,10"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center"/>
                        <Border x:Name="Track" Grid.Column="1" Width="42" Height="24" CornerRadius="12" Background="#363E4B" BorderBrush="#586173" BorderThickness="1">
                            <Ellipse x:Name="Thumb" Width="16" Height="16" Margin="3" Fill="#B5BECC" HorizontalAlignment="Left"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="#164C44"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="#2CE8C6"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="#2CE8C6"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="White"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource Panel}" BorderBrush="#39414E" BorderThickness="1" CornerRadius="20" Padding="30,24">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,22" MouseLeftButtonDown="DragHeader">
                <StackPanel>
                    <TextBlock Text="HEXAWALL" FontSize="11" Foreground="{StaticResource Accent}" FontWeight="Bold"/>
                    <TextBlock Text="Configuración" FontSize="28" FontWeight="SemiBold" Margin="0,7,0,5"/>
                    <TextBlock Text="Los cambios se guardan automáticamente." FontSize="12" Foreground="#A5AEBD"/>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Width="36" Height="36" Padding="0" Click="CloseClicked" ToolTip="Cerrar"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Carpeta de wallpapers" Style="{StaticResource Label}"/>
                    <Grid Margin="0,0,0,23">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderValue" IsReadOnly="True" VerticalContentAlignment="Center" ToolTip="Se leen las imágenes del primer nivel de esta carpeta."/>
                        <Button Grid.Column="1" Content="Examinar…" Margin="10,0,0,0" Click="BrowseClicked"/>
                    </Grid>
                    <TextBlock Text="Atajo global" Style="{StaticResource Label}"/>
                    <TextBox x:Name="HotkeyValue" IsReadOnly="True" GotKeyboardFocus="CaptureStarted" LostKeyboardFocus="CaptureEnded" PreviewKeyDown="CaptureKey"/>
                    <TextBlock Text="Haz clic y presiona la combinación. Esc cancela la captura." Foreground="#A5AEBD" FontSize="11" Margin="0,8,0,23"/>
                    <Grid Margin="0,0,0,23">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Diseño predeterminado" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="LayoutChoice" SelectionChanged="ChoiceChanged"><ComboBoxItem Content="Honeycomb"/><ComboBoxItem Content="CoverFlow"/><ComboBoxItem Content="Cards"/></ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Transición" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="TransitionChoice" SelectionChanged="ChoiceChanged"><ComboBoxItem Content="Hexagon Wipe"/><ComboBoxItem Content="Circle Expand"/><ComboBoxItem Content="Fade"/></ComboBox>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <TextBlock Text="Duración de la transición" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="DurationValue" HorizontalAlignment="Right" Foreground="{StaticResource Accent}"/>
                    </Grid>
                    <Slider x:Name="DurationSlider" Minimum="100" Maximum="2000" TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="DurationChanged" Foreground="{StaticResource Accent}" Margin="0,3,0,23"/>
                    <Border Height="1" Background="#303744" Margin="0,0,0,12"/>
                    <CheckBox x:Name="AllMonitorsToggle" Content="Aplicar en todos los monitores" Checked="ToggleChanged" Unchecked="ToggleChanged"/>
                    <CheckBox x:Name="GamingToggle" Content="Pausar en juegos a pantalla completa" Checked="ToggleChanged" Unchecked="ToggleChanged"/>
                    <CheckBox x:Name="StartupToggle" Content="Iniciar automáticamente con Windows" Checked="ToggleChanged" Unchecked="ToggleChanged"/>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="2" Margin="0,24,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusValue" Text="Listo" Foreground="#A5AEBD" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,18,0"/>
                <Button Grid.Column="1" Content="Listo" MinWidth="96" Click="CloseClicked"/>
            </Grid>
        </Grid>
    </Border>
</Window>
